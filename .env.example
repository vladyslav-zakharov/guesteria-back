# Inside docker compose the host is postgresdb:5432; host-side commands (Prisma CLI, npm run start:dev) use localhost:5435.
DATABASE_URL=postgresql://postgres:12345@postgresdb:5432/postgres
DIRECT_URL=postgresql://postgres:12345@postgresdb:5432/postgres
NODE_ENV=development
# At least 32 characters; generate with: openssl rand -base64 32
APPLICATION_SECRET='change-me-to-a-random-string-of-32-plus-chars'
APPLICATION_URL=http://0.0.0.0:3001
PORT=3001
DOCS_PASSWORD=
FRONTEND_URL=http://localhost:3000
LITEAPI_API_KEY=sand_your-liteapi-sandbox-key
LITEAPI_DATA_URL=https://api.liteapi.travel/v3.0
LITEAPI_BOOK_URL=https://book.liteapi.travel/v3.0
LITEAPI_CURRENCY=EUR
LITEAPI_GUEST_NATIONALITY=UA
GCP_PROJECT_ID=your-gcp-project-id
AI_MODEL=gemini-3.8-flash
AI_LOCATION=global
AI_DAILY_LIMIT=30
# Concierge calls across all users per UTC day.
AI_GLOBAL_DAILY_LIMIT=500
AI_TIMEOUT_MS=25000
# Proxy hops in front of the API whose X-Forwarded-For entries are trusted.
# 0 for local dev without a proxy; 2 in production (Vercel rewrite -> Google Front End -> Cloud Run).
TRUST_PROXY_HOPS=1
